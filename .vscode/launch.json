{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/api",
      "cwd": "${workspaceFolder}/backend",
      "stopOnEntry": true,
      "env": {
        "HTTP_ADDR": "127.0.0.1:8080"
      }
    },
    {
      "name": "Calculator tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/backend/internal/calculator",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
